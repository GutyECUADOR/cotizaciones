<?xml version="1.0"?>
<xmlConfig>
      <variables>
            <variable id="primerDiaVales">
                  <id>primerDiaVales</id>
                  <nombre>Primer dia habilitado Vales</nombre>
                  <descripcion>Define desde que dia del mes estan disponibles los vales por perdida, valor minimo 1.</descripcion>
                  <valor>01</valor>
            </variable>

            <variable id="ultimoDiaVales">
                  <id>ultimoDiaVales</id>
                  <nombre>Ultimo dia habilitado Vales</nombre>
                  <descripcion>Define hasta que dia del mes estan disponibles los vales por perdida, no exceder del ultimo dia del mes.</descripcion>
                  <valor>28</valor>
            </variable>
           
      </variables>
     
</xmlConfig>
